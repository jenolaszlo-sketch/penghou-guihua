<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Penghou.Guihua.Baize</PackageId>
    <Title>Penghou Guihua Baize</Title>
    <Description>Model-backed workflow authoring for Penghou Guihua: authors, proposers, deciders, repair loops, and generic prompt packs.</Description>
    <PackageTags>workflow;planning;fuwen;llm;baize;ai;automation</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PublicApiAnalyzerEnabled>true</PublicApiAnalyzerEnabled>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="prompts\**\*.sbn" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Penghou.Guihua\Penghou.Guihua.csproj" />
    <PackageReference Include="Penghou.Fuwen.Compiler" Version="0.1.0-preview.10" />
    <PackageReference Include="Penghou.Baize" Version="0.3.0-preview.5" />
    <PackageReference Include="Penghou.Baize.Router" Version="0.3.0-preview.5" />
    <PackageReference Include="Penghou.Baize.Tools" Version="0.3.0-preview.5" />
    <PackageReference Include="Scriban" Version="7.2.5" />
  </ItemGroup>

</Project>
